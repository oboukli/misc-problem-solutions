{
  "version": 10,
  "configurePresets": [
    {
      "name": "generic",
      "displayName": "Generic",
      "description": "Generic multi-configuration",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "FORFUN_FEATURE_BENCHMARKS": "ON",
        "FORFUN_FEATURE_TESTS": "ON",
        "FORFUN_FEATURE_FUZZ_TESTS": "OFF",
        "FORFUN_FEATURE_SUPPORT": "ON"
      }
    },
    {
      "name": "visual-studio-18",
      "displayName": "Visual Studio 2026",
      "description": "Build with Visual Studio 2026 (version 18)",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS": "ON",
        "FORFUN_ENABLE_STRICT_COMPILATION": "ON",
        "FORFUN_FEATURE_BENCHMARKS": "ON",
        "FORFUN_FEATURE_TESTS": "ON",
        "FORFUN_FEATURE_FUZZ_TESTS": "OFF",
        "FORFUN_FEATURE_SUPPORT": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "xcode",
      "displayName": "Xcode configuration",
      "description": "Build with Xcode for Darwin",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "CMAKE_XCODE_XCCONFIG": {
          "value": "${sourceDir}/vendor/XcodeWarnings/XcodeWarnings.xcconfig",
          "type": "FILEPATH"
        },
        "COMPILE_DEFINITIONS": "_LIBCPP_ABI_FIX_CITYHASH_IMPLEMENTATION",
        "FORFUN_ENABLE_STRICT_COMPILATION": "ON",
        "FORFUN_FEATURE_BENCHMARKS": "ON",
        "FORFUN_FEATURE_TESTS": "ON",
        "FORFUN_FEATURE_FUZZ_TESTS": "OFF",
        "FORFUN_FEATURE_SUPPORT": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "strict-compilation",
      "displayName": "Strict compilation",
      "description": "Enable most compiler diagnostics and build all but fuzz targets",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Release;RelWithDebInfo;Debug",
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS": "ON",
        "COMPILE_DEFINITIONS": "_LIBCPP_ABI_FIX_CITYHASH_IMPLEMENTATION",
        "FORFUN_ENABLE_STRICT_COMPILATION": "ON",
        "FORFUN_FEATURE_BENCHMARKS": "ON",
        "FORFUN_FEATURE_TESTS": "ON",
        "FORFUN_FEATURE_FUZZ_TESTS": "OFF",
        "FORFUN_FEATURE_SUPPORT": "ON"
      }
    },
    {
      "name": "header-check",
      "displayName": "Header check",
      "description": "Interface header set verification",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "CMAKE_VERIFY_INTERFACE_HEADER_SETS": "ON"
      }
    },
    {
      "name": "code-coverage",
      "displayName": "Code coverage",
      "description": "",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "FORFUN_BUILD_BENCHMARK_TARGETS": "OFF",
        "FORFUN_CONFIGURE_CODE_COVERAGE": "ON",
        "FORFUN_CONFIGURE_INSTALLATION": "OFF"
      }
    },
    {
      "name": "fuzzing",
      "displayName": "Fuzzing",
      "description": "Release build targets with fuzzing configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "ANTLR_BUILD_CPP_TESTS": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "OFF",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "FORFUN_BUILD_TEST_TARGETS": "OFF",
        "FORFUN_BUILD_BENCHMARK_TARGETS": "OFF",
        "FORFUN_BUILD_FUZZ_TARGETS": "ON",
        "FORFUN_CONFIGURE_INSTALLATION": "OFF",
        "FUZZTEST_FUZZING_MODE": "ON"
      }
    },
    {
      "name": "clang-asan-ubsan",
      "displayName": "Clang ASan and UBSan",
      "description": "Build with Clang's AddressSanitizer and UndefinedBehaviorSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O1 -g -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g -DNDEBUG",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": {
          "value": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
          "type": "FILEPATH"
        },
        "COMPILE_DEFINITIONS": "_LIBCPP_ABI_FIX_CITYHASH_IMPLEMENTATION",
        "FORFUN_ASAN_UBSAN_BUILD": "ON",
        "FORFUN_BUILD_BENCHMARK_TARGETS": "OFF",
        "FORFUN_CONFIGURE_INSTALLATION": "OFF"
      },
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Darwin",
          "Linux"
        ]
      }
    },
    {
      "name": "clang-tsan",
      "displayName": "Clang TSan",
      "description": "Build with Clang's ThreadSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
