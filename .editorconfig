root = true

[*.{c,cpp,h,hpp}]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 80
spelling_language = en-US
trim_trailing_whitespace = true

[{*.md,LICENSE}]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 80
spelling_language = en-US
trim_trailing_whitespace = true

[{*.{cff,json,yml},.clang{-format,.-tidy,d},memcheck.supp}]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
spelling_language = en-US
trim_trailing_whitespace = true

[{*.{cmake,cmake.in},CMakeLists.txt}]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
spelling_language = en-US
trim_trailing_whitespace = true

[{.editorconfig,.git*,CODEOWNERS}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
spelling_language = en-US
trim_trailing_whitespace = true

[*.cmd]
charset = utf-8
end_of_line = crlf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 80
spelling_language = en-US
trim_trailing_whitespace = true

[*.sh]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 80
spelling_language = en-US
trim_trailing_whitespace = true

[*.py]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 80
spelling_language = en-US
trim_trailing_whitespace = true
