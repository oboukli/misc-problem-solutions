@PACKAGE_INIT@

cmake_path(
  APPEND_STRING
  CMAKE_FIND_PACKAGE_NAME
    "Targets.cmake"
  OUTPUT_VARIABLE targets_file_name
)

cmake_path(
  APPEND
  CMAKE_CURRENT_LIST_DIR
    "${targets_file_name}"
  OUTPUT_VARIABLE targets_file_path
)

include("${targets_file_path}")

check_required_components(
  "${CMAKE_FIND_PACKAGE_NAME}"
)
